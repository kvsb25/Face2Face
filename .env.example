# Face2Face configuration. Copy to .env and fill in, or run `npm run secrets:init`
# to generate a .env with fresh keys and secrets. Never commit .env.

NODE_ENV=development
LOG_LEVEL=debug

# --- ports ---
HTTP_PORT=3000
WS_PORT=3001
ROOM_MANAGER_PORT=3002
AUTH_PORT=3003
AUTH_SERVICE_URL=http://localhost:3003
ROOM_MANAGER_URL=http://localhost:3002

# --- PostgreSQL ---
# DATABASE_URL is the least-privilege application role (DML only, no DDL).
# DATABASE_URL_MIGRATIONS owns the schema and is used only by Prisma Migrate.
DATABASE_URL="postgresql://f2f_app:CHANGE_ME@localhost:5432/face2face?schema=app&connection_limit=10&pool_timeout=10&connect_timeout=5"
DATABASE_URL_MIGRATIONS="postgresql://f2f_owner:CHANGE_ME@localhost:5432/face2face?schema=app"
TEST_DATABASE_URL="postgresql://f2f_app:CHANGE_ME@localhost:5432/face2face_test?schema=app&connection_limit=5"
TEST_DATABASE_URL_MIGRATIONS="postgresql://f2f_owner:CHANGE_ME@localhost:5432/face2face_test?schema=app"

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_DB=15

# --- JWT (RS256) ---
# PEM keys are base64-encoded so they survive a single-line .env.
JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8_PEM
JWT_PUBLIC_KEY=CHANGE_ME_BASE64_SPKI_PEM
JWT_KEY_ID=CHANGE_ME
JWT_ISSUER=http://localhost:3003
JWT_AUDIENCE=face2face-api
JWKS_URL=http://localhost:3003/.well-known/jwks.json
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REFRESH_FAMILY_MAX_AGE=7776000

# --- password hashing (Argon2id) ---
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=4
PASSWORD_PEPPER=CHANGE_ME_32_BYTES_BASE64

# --- cookies / CSRF ---
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=CHANGE_ME_32_BYTES_BASE64

# --- shared secrets ---
INTERNAL_SERVICE_TOKEN=CHANGE_ME_32_BYTES_BASE64
IP_HASH_SECRET=CHANGE_ME_32_BYTES_BASE64

# --- origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- login throttling (P3 replaces this with the full limiter) ---
LOGIN_MAX_FAILURES=5
LOGIN_BACKOFF_CAP_SECONDS=900

# --- Google OAuth (P4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
