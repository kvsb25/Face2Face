    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "node scripts/migrate-test.js",
    "https": "node server/httpServer/app.js",
    "wss": "node server/wsServer/app.js",
    "rooms": "node server/roomManager/app.js",
    "auth": "node server/authService/app.js"
  },
