    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jose": "^5.10.0",
    "pino": "^10.3.1",
    "redis": "^5.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
